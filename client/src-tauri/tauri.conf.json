{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code Sense",
  "version": "0.1.0",
  "identifier": "com.codesense.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Code Sense",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8585; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"],
    "externalBin": ["binaries/codesense-server", "binaries/llama-server"],
    "resources": {
      "resources/model/": "resources/model/",
      "resources/grype-db/": "resources/grype-db/",
      "resources/semgrep-rules/": "resources/semgrep-rules/",
      "resources/tools/": "resources/tools/",
      "resources/webview2/": "resources/webview2/",
      "resources/llama-runtime/": ""
    },
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "webview2/"
      }
    }
  }
}
