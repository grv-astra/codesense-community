# Copy this file to docker/.env (same folder as docker-compose.community.yml) and fill it in.
# docker/.env holds secrets: never commit it.

# The address people type, and what Caddy serves.
#   domain with HTTPS:  SITE_ADDRESS=codesense.example.com
#   throwaway HTTP test: SITE_ADDRESS=http://203.0.113.5
SITE_ADDRESS=codesense.example.com
# The same host without a scheme (used for the allowed-hosts and CSRF settings).
SITE_HOST=codesense.example.com

# Your own public IP (https://ifconfig.me). Only this address can create the first admin account.
SETUP_ALLOW_IP=203.0.113.10

# Generate each of these:  openssl rand -hex 32
COSIGN_PASSWORD=
LICENSE_SECRET=

# Days of use after first-run setup before the instance goes read-only (the Community licence clock).
LICENSE_DURATION_DAYS=90

# Scan cap. TRIAL_MODE=true gives each scan type (code and SBOM, counted separately) TRIAL_SCAN_LIMIT
# successful scans on this instance in total. Deleting scans does not free a slot. false = no cap here
# (the Community limit of 25 scans per type per 30 days still applies).
TRIAL_MODE=true
TRIAL_SCAN_LIMIT=2

# Optional. Empty = generated once and kept in the data volume.
# DJANGO_SECRET_KEY=
